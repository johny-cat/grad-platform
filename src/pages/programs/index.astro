---
import Base from '../../layouts/Base.astro';
import ProgramRow from '../../components/ProgramRow.astro';
import { getUniversities, isPending } from '../../lib/catalog';
import { CURRENT_CYCLE } from '../../config';

const universities = await getUniversities();
const programs = universities.flatMap((u) => u.programs);
const pendingCount = programs.filter(isPending).length;
const plural = (n: number, one: string, many: string) => `${n} ${n === 1 ? one : many}`;
---

<Base
  title="Programs"
  current="programs"
  description="Deadlines, requirements, funding and live admissions results for graduate programs, checked against official pages."
>
  <div class="wrap">
    <header class="program-head">
      <h1>Programs</h1>
      <p class="lead">
        {CURRENT_CYCLE.label}. Biology and biomedical PhDs in the United States to start, with more fields and
        countries on the way.
      </p>
      {
        pendingCount > 0 && (
          <p class="small muted">
            Programs marked "Details coming" link to their official pages while we check their deadlines and
            requirements. You can follow them and report results already.
          </p>
        )
      }
    </header>

    <form class="filters" id="filters" role="search">
      <div class="search" style="margin-top:0">
        <label class="visually-hidden" for="filter-q">Search programs</label>
        <input
          id="filter-q"
          name="q"
          type="search"
          placeholder="Search by program, university or city"
          autocomplete="off"
        />
      </div>
      <div class="filters__toggles">
        <label class="check"><input type="checkbox" name="intl" /> Funding covers international students</label>
        <label class="check"><input type="checkbox" name="nogre" /> No GRE needed</label>
        <label class="check"><input type="checkbox" name="waiver" /> Fee waivers open to international applicants</label>
      </div>
    </form>

    <p class="count-line" id="count" aria-live="polite">
      {plural(programs.length, 'program', 'programs')} at {plural(universities.length, 'university', 'universities')}
    </p>
    <ol class="uni-list" id="university-list">
      {
        universities.map((university) => (
          <li class="uni">
            <details class="uni__details">
              <summary class="uni__summary">
                <span class="uni__name">{university.name}</span>
                <span class="uni__count" data-count>
                  {plural(university.programs.length, 'program', 'programs')}
                </span>
              </summary>
              <ol class="uni__programs">
                {university.programs.map((program) => (
                  <ProgramRow program={program} inUniversity />
                ))}
              </ol>
            </details>
          </li>
        ))
      }
    </ol>
    <div class="empty" id="no-match" hidden>
      <p>No programs match. Try fewer filters or a different search.</p>
    </div>
    <p class="small muted" style="margin-top:20px">
      Missing a program? <a href="/about/#corrections">Tell us</a> and we'll add it.
    </p>
  </div>
</Base>

<script>
  const form = document.getElementById('filters') as HTMLFormElement;
  const groups = [...document.querySelectorAll<HTMLElement>('#university-list > li')].map((item) => ({
    item,
    details: item.querySelector('details')!,
    count: item.querySelector<HTMLElement>('[data-count]')!,
    rows: [...item.querySelectorAll<HTMLElement>('.program-row')],
  }));
  const count = document.getElementById('count')!;
  const noMatch = document.getElementById('no-match')!;
  const query = form.elements.namedItem('q') as HTMLInputElement;
  const intl = form.elements.namedItem('intl') as HTMLInputElement;
  const noGre = form.elements.namedItem('nogre') as HTMLInputElement;
  const waiver = form.elements.namedItem('waiver') as HTMLInputElement;
  const greFree = ['optional', 'not-required', 'not-accepted'];
  const plural = (n: number, one: string, many: string) => `${n} ${n === 1 ? one : many}`;

  const initial = new URLSearchParams(window.location.search).get('q');
  if (initial) query.value = initial;

  // Which universities the visitor had open before searching, so clearing
  // the search puts the list back the way they left it.
  let openBefore: boolean[] | null = null;

  function apply() {
    const words = query.value.trim().toLowerCase().split(/\s+/).filter(Boolean);
    const filtering = words.length > 0 || intl.checked || noGre.checked || waiver.checked;
    if (filtering && !openBefore) openBefore = groups.map((group) => group.details.open);

    let programs = 0;
    let universities = 0;
    groups.forEach((group, i) => {
      let shown = 0;
      for (const row of group.rows) {
        const data = row.dataset;
        const match =
          words.every((w) => (data.search ?? '').includes(w)) &&
          (!intl.checked || data.intl === 'yes') &&
          (!noGre.checked || greFree.includes(data.gre ?? '')) &&
          (!waiver.checked || data.waiver === 'available');
        row.hidden = !match;
        if (match) shown += 1;
      }
      const all = group.rows.length;
      group.item.hidden = shown === 0;
      group.count.textContent =
        shown < all ? `${shown} of ${plural(all, 'program', 'programs')}` : plural(all, 'program', 'programs');
      if (filtering) group.details.open = shown > 0;
      else if (openBefore) group.details.open = openBefore[i] ?? false;
      if (shown > 0) {
        programs += shown;
        universities += 1;
      }
    });
    if (!filtering) openBefore = null;

    count.textContent = `${plural(programs, 'program', 'programs')} at ${plural(universities, 'university', 'universities')}`;
    noMatch.hidden = programs > 0;
    const url = new URL(window.location.href);
    if (query.value.trim()) url.searchParams.set('q', query.value.trim());
    else url.searchParams.delete('q');
    history.replaceState(null, '', url);
  }

  form.addEventListener('input', apply);
  form.addEventListener('submit', (event) => event.preventDefault());
  apply();
</script>
